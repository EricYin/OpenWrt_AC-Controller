# 复制为 .env 再 `docker compose up`。

# AP 共享密钥（agent 设置页面里填的就是这个值），必填，换成足够长的随机串。
AC_SHARED_SECRET=change-me-to-a-long-random-string

# 初始登录账号密码：只在首次启动播种一次，之后在系统页修改，
# 改这里不会再生效（凭据已入库）。不设置时默认 admin / 123456。
#AC_ADMIN_USER=admin
#AC_ADMIN_PASSWORD=123456

# 反向代理终止 HTTPS 时：强制 Cookie Secure，并信任代理转发头。
# 仅当代理会覆盖 X-Forwarded-For / X-Forwarded-Proto 时才开启后者。
#AC_COOKIE_SECURE=true
#AC_TRUST_PROXY=true
